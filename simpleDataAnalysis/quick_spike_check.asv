%% quick_spike_check
% very crude spike analyser
% sorts and shows spikes according to their electrodenumber (in contrast to display
% number)
clear all
close all

[file,path]= uigetfile
Ts_tot=[];Cs_tot=[];Ns_tot=[];Us_tot=[];
files= dir (fullfile(path , '*.mat'));
for i= 1:size (files,1)
    bestand=files(i).name;bestand
    load ([files(i).folder '\' files(i).name]);
    artefact=1;
    if artefact==1
        disp('Detecting artifacts...');
        [normalWaveformIndices, artifactWaveformIndices, Ts, Us, artifactFlag] = detect_artifacts(Cs, Ts, Us, FileInfo.Samplerate);
        discard= find(artifactFlag==-1 | artifactFlag==-4  | artifactFlag==-5 | artifactFlag==-7);
        Cs(discard)=[];Ts(discard)=[];Ns(discard)=[];Us(discard,:)=[];
    end
          
    Ts_tot=[Ts_tot; Ts];Cs_tot=[Cs_tot; Cs];Ns_tot=[Ns_tot; Ns];Us_tot=[Us_tot; Us]; firingRate=[];

end
figure;plot(Ts_tot);

[Ts, idx]= sort(Ts_tot);Cs=Cs_tot(idx);Ns=Ns_tot(idx);Us=Us_tot(idx,:);
figure;plot(Ts);
